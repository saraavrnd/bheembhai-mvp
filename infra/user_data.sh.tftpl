#!/bin/bash
# ── BheemBhai EC2 user-data ────────────────────────────────────────
# Runs once at first boot on Amazon Linux 2023.
# Logs: /var/log/cloud-init-output.log  |  sudo journalctl -u cloud-init
set -euo pipefail

# ── System updates ─────────────────────────────────────────────────
dnf update -y

# ── Install Docker ─────────────────────────────────────────────────
dnf install -y docker
systemctl enable docker
systemctl start docker
usermod -a -G docker ec2-user

# ── Install docker compose plugin ──────────────────────────────────
dnf install -y docker-compose-plugin
# (available as 'docker compose', not 'docker-compose')

# ── Install git ────────────────────────────────────────────────────
dnf install -y git

# ── Clone the app ──────────────────────────────────────────────────
APP_DIR="/opt/bheembhai"
if [ ! -d "$APP_DIR" ]; then
  git clone --branch "${git_source_branch}" "${git_remote_url}" "$APP_DIR"
else
  cd "$APP_DIR" && git pull origin "${git_source_branch}"
fi

chown -R ec2-user:ec2-user "$APP_DIR"

# ── Write .env ─────────────────────────────────────────────────────
# Secrets that are tokens come from SSM at runtime (the app fetches them).
# Non-secret config is generated here by Terraform.
cat > "$APP_DIR/.env" << 'DOTENV'
# ── Generated by Terraform (user-data) — DO NOT EDIT BY HAND ───────

# Database (local Docker Postgres)
DATABASE_URL=postgresql+asyncpg://bheembhai:bheembhai@localhost:5432/bheembhai

# Security
SECRET_KEY=${app_secret_key}

# Dev mode OFF in deployed environments
DEV_AUTH_BYPASS=false

# Cognito
AUTH_PROVIDER=cognito
COGNITO_REGION=${aws_region}
COGNITO_USER_POOL_ID=${cognito_user_pool_id}
COGNITO_CLIENT_ID=${cognito_client_id}

# S3 Artifacts
STORAGE_BACKEND=s3
S3_BUCKET=${s3_bucket}
S3_REGION=${aws_region}

# Secure Storage
SECURE_STORAGE_BACKEND=${secure_storage_backend}
AWS_DEFAULT_REGION=${aws_region}

# Engine
ENGINE_ID=${environment}-engine-1

# Git
GIT_REMOTE_URL=${git_remote_url}
GIT_SOURCE_BRANCH=${git_source_branch}

# Jira / GitHub / AI vendor credentials are managed per-project via the
# integration API and resolved at runtime — not provisioned here.
DOTENV

# ── Build and start ────────────────────────────────────────────────
cd "$APP_DIR"
docker compose up -d --build
