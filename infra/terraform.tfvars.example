# ── Example Terraform variables ─────────────────────────────────────
# Copy this to terraform.tfvars, fill in your values, and NEVER commit it.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform apply

# ═══════════════════════════════════════════════════════════════════════
# Phase 1 — required now (Cognito + S3 only, no EC2)
# ═══════════════════════════════════════════════════════════════════════

aws_region  = "us-east-1"
environment = "dev"

# Cognito callback URLs (localhost is fine for the boto3 SDK auth flow)
cognito_callback_urls = ["http://localhost:8000"]

# ═══════════════════════════════════════════════════════════════════════
# Phase 2 — only needed when enable_ec2 = true (skip for now)
# ═══════════════════════════════════════════════════════════════════════

# enable_ec2          = true
# instance_type       = "t3.micro"
# ebs_volume_size_gb  = 30
# ssh_key_name        = "your-key-pair-name"     # EC2 Key Pair in AWS console → EC2 → Key Pairs
# ssh_allowed_cidr    = "203.0.113.42/32"        # curl ifconfig.me to get your IP
# git_remote_url      = "https://github.com/you/your-repo.git"
# git_source_branch   = "main"
# app_secret_key      = ""                        # generate: openssl rand -hex 32
