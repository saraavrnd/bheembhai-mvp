# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bheembhai:bheembhai@localhost:5432/bheembhai

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Dev mode ─────────────────────────────────────────────────
# Set to "true" to skip JWT validation — all API calls get a hardcoded
# dev identity. Useful when Cognito isn't provisioned yet.
DEV_AUTH_BYPASS=true

# ── Auth (ADR-010 — pluggable) ───────────────────────────────
AUTH_PROVIDER=cognito
# When DEV_AUTH_BYPASS=false, these must point to a real Cognito pool:
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure AD (if AUTH_PROVIDER=azure_ad)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=

# Okta (if AUTH_PROVIDER=okta)
# OKTA_DOMAIN=
# OKTA_CLIENT_ID=

# ── Object Storage (ADR-011 — pluggable) ─────────────────────
# Options: s3 | azure_blob | minio | local
STORAGE_BACKEND=s3
S3_BUCKET=bheembhai-artifacts-dev
S3_REGION=us-east-1

# ── Secure Storage (ADR-012 — pluggable) ─────────────────────
# Options: aws_ssm | aws_secrets_manager | azure_key_vault | hashicorp_vault | env
# DEV/MVP: aws_ssm (free). Production: aws_secrets_manager (rotation, cross-account).
SECURE_STORAGE_BACKEND=aws_ssm
# AWS SDK resolves credentials from env, instance profile, or ~/.aws/config.
# Resources should be tagged DEV for cost tracking and cleanup.
AWS_DEFAULT_REGION=us-east-1

# ── Engine ───────────────────────────────────────────────────
ENGINE_ID=engine-1
BB_HEARTBEAT_INTERVAL=30
BB_STALE_HEARTBEAT_THRESHOLD=60
BB_POLL_INTERVAL=5

# ── Git ──────────────────────────────────────────────────────
GIT_REMOTE_URL=https://github.com/you/your-repo.git
GIT_SOURCE_BRANCH=main

# ── Agent ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-...
BB_AGENT_IMAGE=bheembhai/agent:latest

# ── Integrations (for skills that talk to Jira/GitHub) ───────
GH_TOKEN=ghp_...
JIRA_URL=https://you.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...
