# ── Database ──────────────────────────────────────────────────
# Docker Compose uses "postgres" hostname; direct run uses "localhost".
DATABASE_URL=postgresql+asyncpg://bheembhai:bheembhai@postgres:5432/bheembhai

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Dev mode ─────────────────────────────────────────────────
# Set to "true" to skip JWT validation — all API calls get a hardcoded
# dev identity. Useful when Cognito isn't provisioned yet.
DEV_AUTH_BYPASS=true

# ── Auth — AWS Cognito ───────────────────────────────────────
AUTH_PROVIDER=cognito
# When DEV_AUTH_BYPASS=false, fill these from: terraform -chdir=infra output env_snippet
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Object Storage (ADR-011) — step attempt logs ──────────────
# local  = dev default: logs land under $BB_WORKDIR/storage (path-parity
#          mount shared by the engine and the platform — no AWS needed)
# s3     = the AWS backend: boto3 default credential chain (env vars or the
#          EC2 instance role); the ENGINE uploads, the PLATFORM reads — give
#          them separate IAM policies (put vs get), agents get no AWS creds
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=/abs/path   (defaults to $BB_WORKDIR/storage in compose)
S3_BUCKET=bheembhai-artifacts-dev
S3_REGION=us-east-1
# S3_ENDPOINT_URL=  (MinIO / LocalStack only)

# ── Secure Storage (ADR-012) ─────────────────────────────────
# Options: env (in-memory, dev) | aws_ssm (free) | aws_secrets_manager (prod)
SECURE_STORAGE_BACKEND=env
AWS_DEFAULT_REGION=us-east-1

# ── Engine ───────────────────────────────────────────────────
ENGINE_ID=engine-1

# ── Git ──────────────────────────────────────────────────────
GIT_REMOTE_URL=https://github.com/you/your-repo.git
GIT_SOURCE_BRANCH=main

# ── Agent ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-...
BB_AGENT_IMAGE=bheembhai/agent:latest

# ═══════════════════════════════════════════════════════════════
# Project-specific secrets (GitHub, Jira, AI vendor keys) are
# NOT stored here — they're managed per-project via the
# integration API: POST /api/projects/{id}/integrations
# ═══════════════════════════════════════════════════════════════
