# DeepSeek via the Anthropic-compatible endpoint. Set ANTHROPIC_AUTH_TOKEN in the
# environment or a secret (not committed here) — this file only maps tiers + endpoint.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN is provided via secret/env, NOT stored in this file
BB_TIER_OPUS=deepseek-v4-pro[1m]
BB_TIER_SONNET=deepseek-v4-pro[1m]
BB_TIER_HAIKU=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max
