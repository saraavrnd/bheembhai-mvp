# BheemBhai configuration — copy to .env and fill in.
#   cp .env.example .env  &&  $EDITOR .env
#
# Precedence: real environment > .env > code defaults. A variable already set in the shell
# (or injected by AWS Secrets Manager / systemd) overrides the value here.
#
# You can paste your existing `export FOO=bar` lines verbatim — the loader strips `export`.
# Secrets live here in local/dev only; in production use Secrets Manager, NOT this file.
# NEVER commit your real .env (see .gitignore).

# --- Model provider -------------------------------------------------------------------
# Default is Anthropic (needs ANTHROPIC_API_KEY). To use a vendor, set BB_MODEL_PROFILE and
# provide ANTHROPIC_AUTH_TOKEN instead. Profiles live in config/profiles/<name>.env.
ANTHROPIC_API_KEY=
# BB_MODEL_PROFILE=deepseek
# ANTHROPIC_AUTH_TOKEN=

# Tier names the workflow may use (unchanged across vendors under Option A).
BB_ALLOWED_MODELS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5

# --- Agent image ----------------------------------------------------------------------
BB_AGENT_IMAGE=bheembhai/agent:latest

# --- Git mode -------------------------------------------------------------------------
# BB_GIT_MODE=1 -> clone/commit/push a real branch (BB_SEED_REPO ignored).
# BB_GIT_MODE=0 -> copy mode, seed from BB_SEED_REPO.
BB_GIT_MODE=1
GIT_REMOTE_URL=
GIT_SOURCE_BRANCH=main
GH_TOKEN=
# BB_SEED_REPO=/path/to/local/repo    # copy mode only

# --- Jira (MCP) -----------------------------------------------------------------------
# Jira Cloud authenticates with the account EMAIL; Server uses a username.
JIRA_URL=
JIRA_EMAIL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# --- Ops / guardrails -----------------------------------------------------------------
BB_STRICT_STARTUP=1
BB_KEEP_CONTAINERS=1
BB_LOG_LEVEL=DEBUG
# BB_MAX_STEP_VISITS=3
